{
  "schema": 1,
  "id": "taumoeba",
  "title": "Taumoeba and the 82.5 Problem",
  "blurb": "A predator crashes the culture; a rising nitrogen ramp breeds it toward tolerance.",
  "teaches": [],
  "seed": 20260802,

  // 1 mm keeps the prey dense enough that a 5 um/s crawl actually finds food -- in the
  // 4 mm field the same count is 16x sparser and predation stalls. Same dynamics as
  // test_evolution (ADR-030), reproduced as a self-contained driven run.
  "chamber": { "w": 1.0e-3, "h": 1.0e-3, "d": 6.0e-5,
               "boundary_x": "reflecting", "boundary_y": "reflecting" },

  "medium": { "kind": "water", "temp_init": 293.15, "co2_init": 0.0, "n2_init": 0.0,
              "thermal_bc": "neumann", "ambient_temp": 293.15,
              "density_model": "canon-mass", "store_disposition": "void",
              "thermal_active": false },

  "light": { "sources": [], "ambient": 0.0 },

  "populations": [
    { "kind": "astrophage", "count": 24000, "placement": "uniform",
      "charge": { "dist": "constant", "value": 0.03 }, "awake": false },
    { "kind": "taumoeba", "count": 1024, "placement": "uniform" }
  ],

  // biology_rate 5e5 cycles digestion/division/death in ~2 ticks, so the arc runs in
  // ~2750 ticks. compaction reclaims eaten prey (so the top-up deficit == what was eaten)
  // and dead predators (so the population turns over at a bounded capacity).
  "clock": { "preset": "custom", "physics_rate": 1.0, "biology_rate": 500000.0 },
  "compaction": true,
  "tau_compaction": true,

  "scope": { "mode": "brightfield", "objective": "WORKING",
             "focal_plane": 0.0, "center": [0.0, 0.0] },

  "tools": ["inject_n2", "seed_taumoeba", "seed_cells"],
  "param_overrides": {},

  // Two stimuli reproduce test_evolution's breeding loop:
  //  - seed_cells holds the prey at 24000 (its top_up_prey), the predator's food.
  //  - set_n2 ramps the uniform nitrogen from N_LETHAL (0.01) to 1.87*N_LETHAL (0.0187)
  //    over 2.175 s. The survival frontier is tol* = N/N_LETHAL - 1, so this is a linear
  //    frontier 0.4*t that clears the 0.825 target near 2.06 s, then holds at the cap
  //    (past 2*N_LETHAL would kill even a tol=1 strain). Directional selection climbs the
  //    mean tolerance and breeds Taumoeba-82.5 (ADR-030), not a script.
  "drive": [
    { "kind": "seed_cells", "t0_s": 0.0, "t1_s": 0.0, "v0": 24000, "v1": 24000 },
    { "kind": "set_n2", "t0_s": 0.0, "t1_s": 2.175, "v0": 0.01, "v1": 0.0187 }
  ],

  "objective": {
    "text": "Introduce the predator, then raise nitrogen across generations to breed Taumoeba-82.5.",
    "duration_s": 2.75,
    "accept": [
      { "metric": "mean_tau_tolerance", "op": ">",  "value": 0.1 },
      { "metric": "max_tau_tolerance",  "op": ">=", "value": 0.825 }
    ]
  }
}
